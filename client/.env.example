# Leave empty to use the Vite dev proxy (recommended in development).
# Set to a full URL (e.g. http://localhost:3001) if you run the client without
# the proxy, or the deployed API origin in production.
VITE_API_BASE_URL=

# Must match the server's API_TOKEN when the server has one set. Sent as
# Authorization: Bearer <token> on every request.
# NOTE: anything in a VITE_ var is bundled into the built client and is visible
# to anyone who loads the page — this gates a shared deployment, it is not a
# per-user secret.
VITE_API_TOKEN=

# Supabase Auth (email/password). Required: without them nobody can sign in, so
# every app route redirects to /sign-in. Both values are from Supabase →
# Project Settings → API. The anon key is meant to be public — it ships in the
# built client like the token above. NEVER put the service_role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
