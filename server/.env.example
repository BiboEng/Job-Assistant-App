# Required: your OpenRouter API key (https://openrouter.ai/keys)
# Treat this like a password. If it ever appears in a commit, a screenshot, a
# support thread, or a shared folder, rotate it immediately at the link above.
OPENROUTER_API_KEY=

# Optional: overrides the default model in src/config.js.
# Prefer a paid model for reliable JSON feedback. Models tagged ":free" are
# heavily rate limited and may ignore JSON response formatting.
# Examples:
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-sonnet
#   google/gemini-flash-1.5
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: backend port (defaults to 3001)
PORT=3001

# --- Job Matches feature ------------------------------------------------

# Adzuna job-search API credentials (https://developer.adzuna.com — free tier).
# Adzuna is the sole Job Matches data source — searched broadly across all
# companies/roles using keywords pulled from the resume. Both keys are
# required; without them Job Matches returns a warning and no jobs.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: fallback Adzuna country if a /api/jobs/match request omits one.
# The Job Matches UI always sends the user's chosen country, so this only
# matters for direct API calls. Default "us". Supported: gb us at au be br ca
# ch de es fr in it mx nl nz pl sg za.
# ADZUNA_COUNTRY=us

# Optional Job Matches tuning:
# JOB_MATCH_ADZUNA_RESULTS=20        # Adzuna listings pulled per search
# JOB_MATCH_ADZUNA_DISTANCE_KM=60    # search radius around the user's city
# JOB_MATCH_MAX_SCORED=12            # hard cap on jobs scored across a search
# JOB_MATCH_SCORE_CONCURRENCY=4      # parallel scoring calls within one batch
# JOB_MATCH_SCORE_BATCH_MAX=4        # jobs the client may score per /jobs/score call
# JOB_MATCH_MODEL_CONCURRENCY=4      # size of the separate "jobs" model-call pool
# JOB_MATCH_RATE_LIMIT_MAX=20        # per-IP /api/jobs requests per minute

# --- Access control -------------------------------------------------------

# STRONGLY RECOMMENDED for anything reachable off your own machine.
# When set, every /api route except /api/health requires
#   Authorization: Bearer <API_TOKEN>
# The client sends it from its own VITE_API_TOKEN.
# API_TOKEN=change-me-to-a-long-random-string

# Optional: comma-separated browser origins allowed to call the API.
# localhost:5173 / 127.0.0.1:5173 are always allowed.
# CLIENT_ORIGIN=https://your-client.example.com

# Express `trust proxy` — controls what the rate limiter sees as the client IP.
# "loopback" (default) trusts only 127.0.0.1. Set to "1" behind exactly one
# proxy/load balancer, or a subnet list. Getting this wrong either lumps every
# caller into one bucket or lets X-Forwarded-For be spoofed.
# TRUST_PROXY=1

# Send HSTS. Only turn on when the app is actually served over HTTPS.
# FORCE_HTTPS=true

# Expose GET /api/interview/:sessionId (read-only session dump) for debugging.
# ENABLE_DEBUG_ROUTES=true

# --- Limits -------------------------------------------------------------

# Per-IP requests/minute on the interview routes (default 30).
# RATE_LIMIT_MAX=30

# Upstream AI call timeout in ms (default 30000).
# OPENROUTER_TIMEOUT_MS=30000

# Cost / abuse ceilings.
# MAX_LIVE_SESSIONS=500            # in-memory sessions held at once
# MAX_CONCURRENT_MODEL_CALLS=8     # simultaneous OpenRouter calls for interviews
# MODEL_CALLS_PER_DAY=5000         # fixed-24h cap across all callers/features (0 = off)
# MAX_INTERVIEWS_PER_OWNER=100     # saved interviews kept per browser

# Where the flat-file history is stored. Point at a mounted volume in
# deployments where the app directory is ephemeral.
# DATA_DIR=/var/data/mock-interview
